{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "jest",
  "jest": {
    "configFile": "jest.config.js"
  },
  "reporters": ["progress", "clear-text"],
  "coverageAnalysis": "perTest",
  "mutate": [
    "features/**/*.{ts,tsx}",
    "!features/**/__tests__/**",
    "!features/**/*.d.ts"
  ],
  "inPlace": true,
  "concurrency": 2,
  "timeoutMS": 15000
}
