# Backend settings for the throwaway E2E stack. Not secrets: every value here
# only works against the in-memory services in docker-compose.e2e.yml.
NODE_ENV=production
PORT=8000

DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=e2e-postgres-password
DB_DATABASE=inshop_e2e
REDIS_HOST=redis
REDIS_PORT=6379

# The browser reaches the backend on localhost:8100 and the frontend on localhost:4100
BETTER_AUTH_URL=http://localhost:8100
BETTER_AUTH_SECRET=e2e-only-secret-not-for-production-0123456789
BETTER_AUTH_COOKIE_DOMAIN=localhost
BETTER_AUTH_SECURE_COOKIES=false
CORS_ALLOWED_ORIGINS=http://localhost:4100

# E2E-only switches; the backend refuses them on real inshop.social hosts
SMS_TRANSPORT=capture
DB_SCHEMA_SYNC=true
RATE_LIMIT_PER_MINUTE=100000
AUTH_RATE_LIMIT_MAX=100000

# Nothing may leave the stack
BALE_ENABLED=false
CDN_PURGE_ENABLED=false
AVALAI_API_KEY=

UPLOAD_S3_ENDPOINT=http://minio:9000
UPLOAD_S3_REGION=us-east-1
UPLOAD_S3_BUCKET=inshop-e2e-uploads
UPLOAD_S3_ACCESS_KEY_ID=e2e-minio
UPLOAD_S3_SECRET_ACCESS_KEY=e2e-minio-password
UPLOAD_S3_PUBLIC_BASE_URL=http://localhost:9102/inshop-e2e-uploads
