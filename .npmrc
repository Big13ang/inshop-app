# Project-level npm registry configuration (Source of Truth)
registry=https://npm.inshop.social/
//npm.inshop.social/:_auth=aW5zaG9wLWRldjpJblNob3BEZXYyMDI2IU5wbVJlZ2lzdHJ5
always-auth=true


# Timeout and retry settings to handle slow upstream connections gracefully
fetch-timeout=60000
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
fetch-retries=3
fetch-retry-factor=2

audit=false
fund=false
update-notifier=false
